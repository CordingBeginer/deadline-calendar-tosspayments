PORT=3000

# 토스페이먼츠 개발자센터(https://developers.tosspayments.com)에서 확인한 테스트 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_YOUR_CLIENT_KEY
TOSS_SECRET_KEY=test_sk_YOUR_SECRET_KEY

# (선택) Gemini API 키 - 브라우저에 노출하지 않고 서버 라우트에서만 사용
GEMINI_API_KEY=

# (선택) 디스코드 실시간 알림 웹훅 URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# (선택) 이메일 알림 설정 (Gmail 앱 비밀번호)
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_16digit_app_password
# DEMO_NOTIFY_EMAIL=student@univ.ac.kr
